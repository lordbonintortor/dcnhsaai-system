# Copy to .env.local. Keep real values out of Git.
# Use the project URL and publishable key from Supabase > Project Settings > API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server only: resolves usernames for existing and new accounts. Never use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-key
APP_URL=http://localhost:3000
